<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.daily-naver-blog</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/user/CursorProjects/ai-blog-notes/scripts/daily-naver-blog.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/user/CursorProjects/ai-blog-notes</string>

    <!-- 매일 새벽 00:00 (자정) 실행: 맥이 슬립 상태인 경우 깨어나는 즉시 실행 보장 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>0</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/user/CursorProjects/ai-blog-notes/logs/launchd.out</string>

    <key>StandardErrorPath</key>
    <string>/Users/user/CursorProjects/ai-blog-notes/logs/launchd.err</string>
</dict>
</plist>
